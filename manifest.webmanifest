{
  "name": "Griefcase — Leave it here. Feel a little lighter.",
  "short_name": "Griefcase",
  "description": "A private, anonymous space to write down what's weighing on you, leave it there, and feel a little lighter. Not therapy, not a social network — just somewhere to put things down.",
  "id": "/",
  "start_url": "./index.html?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#F4EEE3",
  "theme_color": "#F4EEE3",
  "lang": "en",
  "dir": "ltr",
  "categories": ["lifestyle", "personalization", "utilities"],
  "icons": [
    { "src": "icons/favicon-16.png", "sizes": "16x16", "type": "image/png" },
    { "src": "icons/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "icons/screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The Griefcase writing space, open and ready"
    },
    {
      "src": "icons/screenshot-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Griefcase on mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Griefcase",
      "short_name": "Write",
      "description": "Jump straight into a blank page",
      "url": "./index.html?action=write",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Griefcase",
      "short_name": "My Griefcase",
      "description": "See what you've left here before",
      "url": "./index.html?action=library",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
